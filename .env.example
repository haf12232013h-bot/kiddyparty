html {
  font-family: Arial, Helvetica, sans-serif;
  background: linear-gradient(180deg, #fff7fb 0%, #f6f1ff 100%);
  color: #1e1b4b;
}

* {
  box-sizing: border-box;
}

a {
  color: #7c3aed;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

body {
  margin: 0;
  min-height: 100vh;
}

.app-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 32px 20px 60px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28px;
  gap: 12px;
}

.brand {
  font-size: 2rem;
  font-weight: 800;
  letter-spacing: -0.06em;
  color: #5b21b6;
}

.card {
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(124, 58, 237, 0.12);
  border-radius: 24px;
  box-shadow: 0 20px 45px rgba(87, 35, 129, 0.08);
}

.hero {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 20px;
  margin-bottom: 20px;
}

.hero-main,
.side-panel,
.panel {
  padding: 24px;
}

.hero-main h1 {
  margin-top: 0;
  margin-bottom: 10px;
  font-size: clamp(2.3rem, 5vw, 4rem);
  letter-spacing: -0.07em;
}

.hero-main p {
  margin-bottom: 18px;
  color: #4b5563;
}

.inline-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.primary,
.secondary,
.small-btn {
  border-radius: 12px;
  padding: 12px 18px;
  font-weight: 700;
  border: none;
}

.primary {
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: white;
}

.secondary {
  border: 1px solid rgba(124, 58, 237, 0.2);
  background: white;
  color: #4c1d95;
}

.small-btn {
  background: rgba(139, 92, 246, 0.12);
  color: #4c1d95;
  padding: 8px 12px;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(120px, 1fr));
  gap: 12px;
  margin-top: 20px;
}

.metric {
  padding: 16px;
  border-radius: 16px;
  background: linear-gradient(180deg, rgba(243, 232, 255, 0.8), rgba(255, 255, 255, 0.6));
}

.metric strong {
  display: block;
  font-size: 1.5rem;
  color: #4c1d95;
}

.metric span {
  color: #6b7280;
  font-size: 0.9rem;
}

.form-block {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.input {
  width: 100%;
  border: 1px solid rgba(124, 58, 237, 0.2);
  background: white;
  border-radius: 12px;
  padding: 12px 14px;
}

.room-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.room-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px;
  background: white;
  border: 1px solid rgba(124, 58, 237, 0.12);
  border-radius: 16px;
}

.room-item h3 {
  margin: 0 0 6px;
}

.room-item p {
  margin: 0;
  color: #6b7280;
}

.room-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

.center-box {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 32px 20px;
  background: linear-gradient(180deg, #fdf2f8, #f5f3ff);
}

.auth-card {
  width: min(480px, 100%);
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid rgba(124, 58, 237, 0.1);
  border-radius: 28px;
  padding: 28px;
  box-shadow: 0 20px 45px rgba(49, 46, 129, 0.08);
}

.auth-card h1 {
  margin-top: 0;
  margin-bottom: 8px;
}

.auth-card p {
  color: #4b5563;
  margin-bottom: 20px;
}

.status-box {
  border-radius: 12px;
  background: rgba(139, 92, 246, 0.08);
  color: #4c1d95;
  padding: 10px 12px;
  font-weight: 600;
}

.chat-shell {
  max-width: 1000px;
  margin: 0 auto;
  padding: 24px 18px 48px;
}

.chat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.chat-layout {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 20px;
}

.sidebar,
.chatbox {
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(124, 58, 237, 0.12);
  border-radius: 24px;
  overflow: hidden;
}

.sidebar {
  padding: 18px;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 16px;
}

.member-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #faf5ff;
  border-radius: 12px;
  padding: 10px 12px;
}

.chatbox {
  display: flex;
  flex-direction: column;
  min-height: 680px;
}

.chat-header {
  padding: 18px 20px;
  border-bottom: 1px solid rgba(124, 58, 237, 0.12);
}

.chat-header h2 {
  margin: 0;
}

.chat-messages {
  flex: 1;
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: linear-gradient(180deg, #fff7fb 0%, #f4f7ff 100%);
}

.message {
  max-width: 72%;
  border: 1px solid rgba(124, 58, 237, 0.08);
  border-radius: 16px;
  padding: 10px 12px;
  background: white;
}

.message.self {
  align-self: flex-end;
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: white;
}

.message strong {
  display: block;
  margin-bottom: 4px;
  font-size: 0.82rem;
}

.message time {
  display: block;
  margin-top: 8px;
  font-size: 0.72rem;
  opacity: 0.85;
}

.chat-compose {
  display: flex;
  gap: 10px;
  padding: 18px 20px;
  border-top: 1px solid rgba(124, 58, 237, 0.12);
}

.chat-compose input {
  flex: 1;
}

.empty-state {
  color: #6b7280;
  font-size: 0.95rem;
}

@media (max-width: 820px) {
  .hero,
  .chat-layout {
    grid-template-columns: 1fr;
  }
}
